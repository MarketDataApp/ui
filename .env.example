# Environment variables for the Playwright e2e suite (tests/e2e).
# Copy this file to `.env` (gitignored) and fill in the real value(s).
#
# ─────────────────────────────────────────────────────────────────────────
# AMEMBER_AUTOLOGIN_URL
#   amember autologin link used by tests/e2e/auth.setup.js to log the suite
#   in once and save the session (storageState) for the authenticated specs.
#
#   Test user: `playwright-free` — a dedicated test-harness member on
#   PRODUCTION dashboard.marketdata.app with NO paid subscription. The
#   authenticated specs (user-profile.spec.js) only require a logged-in user
#   whose profile dropdown shows a name + email; no plan or product is
#   needed, so this free account exercises the full user-profile UI. If the
#   profile UI ever grows subscription-gated elements, add a SEPARATE paid
#   harness user rather than upgrading this one.
#
#   This value is a login credential — keep the real one OUT of git. The line
#   below is only a placeholder. Set the real value in `.env` locally and in
#   CI as the AMEMBER_AUTOLOGIN_URL secret.
# ─────────────────────────────────────────────────────────────────────────
AMEMBER_AUTOLOGIN_URL=https://dashboard.marketdata.app/marketdata/l/REPLACE_WITH_AUTOLOGIN_TOKEN
